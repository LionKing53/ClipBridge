{
  "name": "panokopru",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "PanoKopru - Shortcut-triggered iPhone and Windows clipboard bridge (development baseline)",
  "type": "module",
  "scripts": {
    "build:candidate": "node scripts/build-candidate.js",
    "toolchain:fetch": "node scripts/acquire-toolchain.js",
    "build:native": "node scripts/build-native.js",
    "build": "node scripts/build-app.js",
    "start": "node src/server.js",
    "info": "node src/info.js",
    "pair": "node src/pair.js",
    "test": "node --test test/*.test.js",
    "test:ui": "node scripts/verify-desktop-ui.js",
    "check:source": "node scripts/check-source.js",
    "report:dependencies": "node scripts/dependency-report.js"
  },
  "dependencies": {
    "archiver": "8.0.0",
    "busboy": "1.6.0",
    "mime-types": "3.0.2",
    "multicast-dns": "7.2.5",
    "qrcode": "1.5.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "png-to-ico": "3.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
